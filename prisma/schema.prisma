// Macnet Solutions data model (MongoDB). Prisma 6 is used because Prisma 7 has no MongoDB support.
generator client {
  provider      = "prisma-client-js"
  // native = this Mac; the others cover the Linux servers cPanel hosts commonly run.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  SALES
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum LeadType {
  QUOTE
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

type ImageRef {
  url    String
  alt    String
  width  Int
  height Int
}

type Seo {
  title       String?
  description String?
  ogImage     String?
}

type ResultStat {
  value String
  label String
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  email        String     @unique
  name         String?
  passwordHash String
  role         Role       @default(ADMIN)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  activities   Activity[]
  leads        Lead[]     @relation("LeadAssignee")
}

model Brand {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String        @unique
  client    String
  sector    String
  location  String
  year      Int
  summary   String?
  challenge Json?
  solution  Json?
  results   ResultStat[]
  cover     ImageRef?
  gallery   ImageRef[]
  status    PublishStatus @default(PUBLISHED)
  isMock    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Service {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String        @unique
  summary   String
  body      Json?
  points    String[]
  order     Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Post {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  excerpt     String
  body        Json?
  cover       ImageRef?
  tags        String[]
  author      String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  seo         Seo?
  isMock      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  role      String?
  company   String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  isMock    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  bio       String?
  photo     ImageRef?
  order     Int       @default(0)
  visible   Boolean   @default(true)
  isMock    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PageSection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  page      String
  kind      String
  order     Int      @default(0)
  data      Json
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, order])
}

model Office {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  address   String
  phones    String[]
  email     String?
  mapUrl    String?
  hours     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique @default("site")
  data      Json
  updatedAt DateTime @updatedAt
}

model Lead {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  type       LeadType
  name       String
  company    String?
  email      String
  phone      String?
  message    String?
  source     String?
  status     LeadStatus @default(NEW)
  notes      String?
  assigneeId String?    @db.ObjectId
  assignee   User?      @relation("LeadAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status, createdAt])
}

model Media {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  alt       String?
  width     Int?
  height    Int?
  mime      String?
  size      Int?
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  entity    String
  entityId  String?
  summary   String?
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}
