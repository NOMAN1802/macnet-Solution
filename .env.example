# Copy to .env and fill in. Never commit .env.
# MongoDB (must be a replica set; Atlas URLs work as-is).
DATABASE_URL="mongodb://localhost:27018/macnet?replicaSet=rs0&directConnection=true"
# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# First admin account, created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
# Where new quote / contact leads are sent (spelling unconfirmed by owner)
LEAD_ALERT_EMAIL="sales@macnetsolution.com.bd"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
